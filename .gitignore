# Build output. Rebuild with build-cli.ps1 / build-mcp.ps1 / build-server.ps1.
bin/
bin-cli/
bin-server/
obj/
*.user

# grimora.cs and mcp.cs were file-based apps with no .csproj on disk, so *.csproj was a blanket rule
# against any stray generated project file. RESTRUCTURE.md slice 2 adds real, tracked .csproj files
# under src/ and tests/ for the new solution; those are source, not build output.
/grimora.csproj
/mcp.csproj

# Per-instance stores live in ~/.grimora, never in the repo.
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak-*

# Curated per-ecosystem exports. Project-specific knowledge, not engine code.
seeds/
probe/runs/
ship-msg*.txt

# Disposable fixture trees a test builds and deletes; never real content.
.test-fixtures/

# JetBrains Rider / IDE state.
.idea/
