<Project>
  <!-- Code-style rules (repo-root .editorconfig) are enforced in the build for tests too: the cleanup
       that prompted them touched test files as well. IDE0060 stays src-only (src/.editorconfig). -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only reports in a build when the XML doc file is generated (roslyn#41640).
         XML doc warnings (CS15xx) are not rules here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591</NoWarn>
  </PropertyGroup>
</Project>
