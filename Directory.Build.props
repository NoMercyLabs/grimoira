<Project>
  <!-- grimora.cs and mcp.cs are file-based apps at the repo root (RESTRUCTURE.md section 0 rule 3: they
       keep running, unchanged, until their own slice moves each feature out from under them). Their
       generated virtual project sits in the same directory as this file, so without this guard it
       would inherit every setting below and break a build that passed before slice 2: central package
       management collides with their own inline #:package version directives, and warnings-as-errors
       turns their existing (pre-slice-2) trim-safety warning into a build failure. Scoped by project
       name, not by command line, so a real project reference such as Grimora.Store (proved by the
       #:project line slice 2 adds to grimora.cs) still gets the strict settings.

       The name a file-based app's generated project gets is not stable across .NET SDK feature
       bands: SDK 10.0.112 (the dev box, pinned in global.json) names it "grimora"/"mcp", but CI's
       "10.0.x" resolved a band that names it "grimora.cs"/"mcp.cs" instead, so the exact-name match
       below missed it, central package management applied anyway, and NU1008 failed the restore
       (the #:package lines set a Version, which CPM forbids). Matching by StartsWith keeps both
       forms, and ManagePackageVersionsCentrally gets its own explicit condition on both sides
       (false for the two apps, true otherwise) instead of being merely absent for them, so the
       property is never left to whatever the ambient default happens to be. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('grimora')) AND !$(MSBuildProjectName.StartsWith('mcp'))">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('grimora')) OR $(MSBuildProjectName.StartsWith('mcp'))">
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('grimora')) AND !$(MSBuildProjectName.StartsWith('mcp'))">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
