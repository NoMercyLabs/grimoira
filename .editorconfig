# The code style is enforced by the build (EnforceCodeStyleInBuild in src/ and tests/), not by a
# hand-run IDE cleanup. Each rule below is an error, so `dotnet build` fails on a violation and
# `dotnet format style --verify-no-changes` (verify.ps1, CI) fails on a file that needs the fix.
# To fix a whole tree: run the command in the "style:" commit message.
root = true

[*.cs]
# Explicit types, never var (IDE0008): the codebase declares the type on every local.
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

# Collection expressions.
dotnet_style_prefer_collection_expression = true:error
dotnet_style_collection_initializer = true:error
csharp_style_implicit_object_creation_when_type_is_apparent = true:error

dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0008.severity = error
dotnet_diagnostic.IDE0028.severity = error
dotnet_diagnostic.IDE0090.severity = error
dotnet_diagnostic.IDE0300.severity = error
dotnet_diagnostic.IDE0301.severity = error
dotnet_diagnostic.IDE0305.severity = error
dotnet_diagnostic.IDE0370.severity = error
dotnet_diagnostic.SYSLIB1045.severity = error
