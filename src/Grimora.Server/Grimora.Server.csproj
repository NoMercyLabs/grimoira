<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Slice 25 (RESTRUCTURE.md): the Kestrel host. Sdk.Web brings the ASP.NET Core shared framework
         reference needed for WebApplication/Kestrel; this project is not published standalone by any
         other slice yet, so nothing else in the repo depends on this being Sdk vs Sdk.Web. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sdk.Web (added by slice 25 for the Kestrel host) brings Microsoft.Extensions.Hosting
         transitively; an explicit reference here is pruned as redundant (NU1510) and fails the build
         under TreatWarningsAsErrors. -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Grimora.Store/Grimora.Store.csproj" />
    <ProjectReference Include="..\Grimora.Facts\Grimora.Facts.csproj" />
    <ProjectReference Include="..\Grimora.Memory\Grimora.Memory.csproj" />
    <ProjectReference Include="..\Grimora.Docs\Grimora.Docs.csproj" />
    <ProjectReference Include="..\Grimora.Graph\Grimora.Graph.csproj" />
    <ProjectReference Include="..\Grimora.Brain\Grimora.Brain.csproj" />
    <ProjectReference Include="..\Grimora.Hooks\Grimora.Hooks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Grimora.Server.Tests" />
  </ItemGroup>
</Project>
