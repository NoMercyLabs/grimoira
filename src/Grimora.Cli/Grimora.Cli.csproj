<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Slice 29d: the built binary is the `grimora` command itself (grimora.exe / grimora), a thin client of POST /cli. -->
    <AssemblyName>grimora</AssemblyName>
    <RootNamespace>Grimora.Cli</RootNamespace>
    <DefineConstants>$(DefineConstants);Grimora_CLI_LINKED</DefineConstants>
  </PropertyGroup>
  <!-- Section 1: Cli "may depend on nothing in Grimora except a small shared request contract, which it
       copies from Store at build time (a linked source file)." No ProjectReference is allowed here
       (Grimora.Layout.Tests.ReferenceDirectionTests.CliReferencesNothingInGrimora), so the two hook handlers
       are compiled into Grimora.Cli the same way: linked source, not a project reference. Grimora.Hooks still
       owns and tests them; this is a build-time copy of the same file. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Grimora.Store/Data/RegexTimeout.cs" Link="Data/RegexTimeout.cs" />
    <Compile Include="../Grimora.Hooks/Data/HookPaths.cs" Link="Hooks/HookPaths.cs" />
    <Compile Include="../Grimora.Hooks/Tools/CompactBriefTool.cs" Link="Hooks/CompactBriefTool.cs" />
    <Compile Include="../Grimora.Hooks/Tools/CompactRestoreTool.cs" Link="Hooks/CompactRestoreTool.cs" />
    <Compile Include="..\Grimora.Brain\Data\IProcessRunner.cs">
      <Link>Data\IProcessRunner.cs</Link>
    </Compile>
    <!-- Slice 27: `server install-logon`/`uninstall-logon` run schtasks through this seam. Same
         no-ProjectReference rule as above, so it is a build-time linked copy of Grimora.Brain's file, not
         a reference to Grimora.Brain. -->
  </ItemGroup>
</Project>
