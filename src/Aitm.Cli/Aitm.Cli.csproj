<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <!-- Section 1: Cli "may depend on nothing in AITM except a small shared request contract, which it
       copies from Store at build time (a linked source file)." No ProjectReference is allowed here
       (Aitm.Layout.Tests.ReferenceDirectionTests.CliReferencesNothingInAitm), so the two hook handlers
       are compiled into Aitm.Cli the same way: linked source, not a project reference. Aitm.Hooks still
       owns and tests them; this is a build-time copy of the same file. -->
  <ItemGroup>
    <Compile Include="../Aitm.Hooks/Data/HookPaths.cs" Link="Hooks/HookPaths.cs" />
    <Compile Include="../Aitm.Hooks/Tools/CompactBriefTool.cs" Link="Hooks/CompactBriefTool.cs" />
    <Compile Include="../Aitm.Hooks/Tools/CompactRestoreTool.cs" Link="Hooks/CompactRestoreTool.cs" />
  </ItemGroup>
</Project>
