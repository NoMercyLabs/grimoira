<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Slice 25 (RESTRUCTURE.md): the Kestrel host. Sdk.Web brings the ASP.NET Core shared framework
         reference needed for WebApplication/Kestrel; this project is not published standalone by any
         other slice yet, so nothing else in the repo depends on this being Sdk vs Sdk.Web. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sdk.Web (added by slice 25 for the Kestrel host) brings Microsoft.Extensions.Hosting
         transitively; an explicit reference here is pruned as redundant (NU1510) and fails the build
         under TreatWarningsAsErrors. -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Grimoira.Store/Grimoira.Store.csproj" />
    <ProjectReference Include="../Grimoira.Facts/Grimoira.Facts.csproj" />
    <ProjectReference Include="../Grimoira.Memory/Grimoira.Memory.csproj" />
    <ProjectReference Include="../Grimoira.Docs/Grimoira.Docs.csproj" />
    <ProjectReference Include="../Grimoira.Graph/Grimoira.Graph.csproj" />
    <ProjectReference Include="../Grimoira.Brain/Grimoira.Brain.csproj" />
    <ProjectReference Include="../Grimoira.Hooks/Grimoira.Hooks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Grimoira.Server.Tests" />
  </ItemGroup>
</Project>
