<Project>
  <!-- RESTRUCTURE.md slice 24 "Also": an unused parameter is a build error under src/ only —
       not tests/, and not the file-based grimora.cs/mcp.cs apps (they live at the repo root, above
       this folder, so MSBuild never applies this file to them). EnforceCodeStyleInBuild turns on
       code-style analysis (IDE-prefixed rules) during `dotnet build`, not just in the IDE; the
       severity itself (error) comes from src/.editorconfig's dotnet_diagnostic.IDE0060.severity. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only reports in a build when the XML doc file is generated (roslyn#41640).
         XML doc warnings (CS15xx) are not rules here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591</NoWarn>
  </PropertyGroup>
</Project>
